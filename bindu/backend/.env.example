APP_ENV=development
APP_NAME=BINDU
API_V1_PREFIX=/api/v1

# --- AI provider: meta | mock  (mock is clearly labelled in the API and app) ---
# Meta Muse Spark powers Explore with AI, Ask BINDU and postcards. Key from https://dev.meta.ai
AI_PROVIDER=mock
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3 = Standard mode (prompts/photos not used for training). muse-spark-1.3-contributor is cheaper but may be trained on.
META_MODEL_NAME=muse-spark-1.3
META_STRUCTURED_OUTPUT=true
# Muse Spark always reasons; low keeps answers fast. Leave empty to omit. Reasoning tokens count toward the output cap below.
META_REASONING_EFFORT=low
META_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Auth: "dev" accepts `Bearer dev-<name>` (development only); "supabase" verifies Supabase tokens ---
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Server only. Needed for DELETE /account. Never put this in the mobile app or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Limits ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MAX_UPLOAD_SIZE_MB=10
AI_RATE_LIMIT_PER_MINUTE=10

# --- Swar Nepali TTS. Leave SWAR_BASE_URL empty to disable server-side TTS. ---
SWAR_BASE_URL=
SWAR_API_KEY=
SWAR_VOICE_ID=
SWAR_QUALITY=fast
